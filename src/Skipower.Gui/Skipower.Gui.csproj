<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Skipower.Gui</AssemblyName>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Skipower.Core\Skipower.Core.csproj" />
    <ProjectReference Include="..\Skipower.Windows\Skipower.Windows.csproj" />
    <PackageReference Include="Aprillz.MewUI.Core" Version="0.18.1" />
    <PackageReference Include="Aprillz.MewUI.Platform.Win32" Version="0.18.1" />
    <PackageReference Include="Aprillz.MewUI.Backend.Gdi" Version="0.18.1" />
  </ItemGroup>
</Project>
